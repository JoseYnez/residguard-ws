# Conexión como role_app (sin DELETE físico; RLS tenant-scoped en todas las
# tablas de negocio — ver residguard_db/CLAUDE.md §15)
DATABASE_URL=postgresql://role_app:CHANGE_ME@localhost:5432/residguard

# auth_ws: /.well-known/keys para validar access tokens localmente (Ed25519)
AUTH_WS_BASE_URL=http://localhost:3001

# admin_ws: superficie tenant /tenant/v1 (decisión #23 de admin_project) con la
# que este servicio invita usuarios del cliente. Las llamadas viajan con el
# access token del usuario final; https obligatorio en producción.
ADMIN_WS_BASE_URL=http://localhost:3002

# Rol (auth.roles.code de residguard-app) que se asigna al invitar a una
# persona del padrón. Debe existir como rol asignable en la plataforma
# (99_patch_residguard_resident_role.sql).
RESIDENT_ROLE_CODE=community_resident

# appCode de ResidGuard en el catálogo de la plataforma (core.apps.code del
# sistema de auth): ancla de autorización del resource server — solo se
# aceptan access tokens firmados con la clave de esta app.
RESIDGUARD_APP_CODE=residguard-app

# Ventana de gracia (minutos) para los permisos cacheados de una sesión cuando
# auth_ws no responde. Este servicio no comparte la BD de la plataforma, así que
# no tiene resolver local al que degradar: sirve la última respuesta conocida de
# auth_ws durante esta ventana. Nunca concede un permiso que auth_ws no haya
# afirmado; solo relaja la frescura. 0 = fallar cerrado (503) al vencer el TTL.
PERMISSIONS_STALE_GRACE_MINUTES=15

# Orígenes CORS permitidos (coma). Vacío = ningún origen cruzado. El SPA
# residguard_app en dev usa :4204.
CORS_ORIGINS=http://localhost:4204

# Zona horaria de operación, fijada en cada sesión de PostgreSQL. NO decide qué
# instante se guarda (el navegador manda su fecha-hora ya con offset), sino cómo
# se agrupa por día: `paid_at::date`, `CURRENT_DATE` y el corte de saldo se
# evalúan en esta zona. Dejarla en UTC haría que los pagos de la tarde cayeran
# en el día siguiente para filtros y cortes.
DB_TIMEZONE=America/Mexico_City

PORT=3003
HOST=0.0.0.0
LOG_LEVEL=info

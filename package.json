{
  "name": "residguard_ws",
  "version": "0.0.1",
  "description": "API de negocio de ResidGuard: comunidades, unidades, miembros, pagos, gastos y movimientos de caja",
  "private": true,
  "type": "commonjs",
  "main": "dist/server.js",
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "fastify": "^5.8.5",
    "jose": "^6.2.3",
    "pg": "^8.21.0",
    "structure-verifier": "^1.1.3"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "@types/pg": "^8.20.0",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
